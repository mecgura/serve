# MecGuraServe - Environment Variables

# Django
SECRET_KEY=django-insecure-mecguraserve-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for development)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Razorpay (Resort provides their own keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp Business API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# CORS
CSRF_TRUSTED_ORIGINS=http://localhost:8000
